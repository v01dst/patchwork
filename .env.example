# Supabase Connection (Server-side & Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# External /api/* integration surface (server-side only, never exposed to the browser).
# REQUIRED for the optional external API to function AT ALL.
# If omitted, every /api/* route rejects all requests with a 500 (fail-closed),
# intentionally disabling that surface entirely — it NEVER opens access.
# The app UI itself is unaffected: it uses Next.js Server Actions, not /api/*.
PATCHWORK_API_SECRET=your-external-api-secret-placeholder
